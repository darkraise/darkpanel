{
  "name": "demo.item.add",
  "version": 1,
  "class": "revertible",
  "side": "agent",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/addInput",
    "$defs": {
      "addInput": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z]+$"},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "mode": {
            "type": "string",
            "enum": ["fast", "safe"],
            "default": "safe"
          }
        },
        "additionalProperties": false,
        "required": ["name", "port"]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/addOutput",
    "$defs": {
      "addOutput": {
        "type": "object",
        "properties": {
          "identifier": {"type": "string"},
          "state": {"type": "string", "enum": ["active", "idle"]}
        },
        "required": ["identifier", "state"]
      }
    }
  }
}
