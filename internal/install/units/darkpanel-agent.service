# Written by darkpanel system install; rerun it rather than editing this file.
[Unit]
Description=Darkpanel agent
Documentation=https://github.com/Darkraise/darkpanel
Wants=network-online.target
# Startup recovery reverts against the loaded firewall, so the programs that
# load rules finish first: a unit that is absent or disabled is ignored.
After=network-online.target ufw.service docker.service tailscaled.service
StartLimitIntervalSec=60
StartLimitBurst=5
OnFailure=darkpanel-rollback.service

[Service]
ExecStart={{.Binary}} agent run
RuntimeDirectory=darkpanel-agent
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=2
RestartMode=direct
SuccessExitStatus=70
RestartForceExitStatus=70
TimeoutStartSec=30s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
