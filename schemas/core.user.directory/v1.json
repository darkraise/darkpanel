{
  "name": "core.user.directory",
  "version": 1,
  "class": "read",
  "side": "controller",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/NoInput",
    "$defs": {
      "NoInput": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/Directory",
    "$defs": {
      "Directory": {
        "properties": {
          "users": {
            "items": {
              "$ref": "#/$defs/DirectoryUser"
            },
            "type": "array",
            "description": "Every user, sorted by username."
          }
        },
        "type": "object",
        "required": [
          "users"
        ]
      },
      "DirectoryUser": {
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "disabled": {
            "type": "boolean",
            "description": "True while core.user.disable keeps the user from signing in."
          },
          "grants": {
            "items": {
              "$ref": "#/$defs/Grant"
            },
            "type": "array",
            "description": "The user's grants, sorted by target; they apply only while the user is a member."
          },
          "email": {
            "type": "string",
            "description": "The email an OIDC sign-in matches; empty when unset."
          },
          "tailnetLogin": {
            "type": "string",
            "description": "The tailnet login a Tailscale sign-in matches; empty when unset."
          },
          "signIn": {
            "items": {
              "type": "string",
              "enum": [
                "password",
                "oidc",
                "tailscale"
              ]
            },
            "type": "array",
            "description": "The sign-in methods the user has: password once it has a password of its own, oidc and tailscale once a sign-in by that method linked the account."
          },
          "inviteExpiresAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "When the user's enrollment link expires; null when it has no unused link or the link was ended."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "role",
          "state",
          "createdAt",
          "grants",
          "email",
          "tailnetLogin",
          "signIn",
          "inviteExpiresAt"
        ]
      },
      "Grant": {
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "A host group id, or * for every host, including hosts enrolled later."
          },
          "role": {
            "type": "string",
            "enum": [
              "viewer",
              "operator"
            ],
            "description": "viewer gives read, operator gives operate."
          }
        },
        "type": "object",
        "required": [
          "target",
          "role"
        ]
      }
    }
  }
}
