{
  "name": "system.packages.install",
  "version": 1,
  "class": "compensable",
  "side": "agent",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/InstallInput",
    "$defs": {
      "InstallInput": {
        "properties": {
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "The packages to install, as the configured sources name them."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "names"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/Applied",
    "$defs": {
      "Applied": {
        "properties": {
          "installed": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "upgraded": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "removed": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "installed",
          "upgraded",
          "removed"
        ]
      }
    }
  }
}
