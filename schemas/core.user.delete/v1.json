{
  "name": "core.user.delete",
  "version": 1,
  "class": "irreversible",
  "side": "controller",
  "breakGlass": true,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/UsernameInput",
    "$defs": {
      "UsernameInput": {
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "description": "The user's name."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/Empty",
    "$defs": {
      "Empty": {
        "properties": {},
        "type": "object"
      }
    }
  }
}
