{
  "name": "system.docker.check",
  "version": 1,
  "class": "read",
  "side": "controller",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/dockerCheckIn",
    "$defs": {
      "dockerCheckIn": {
        "properties": {
          "hostId": {
            "type": "string",
            "minLength": 1
          },
          "firewallIntegration": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "hostId",
          "firewallIntegration"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/DockerCheckResult",
    "$defs": {
      "DockerCheckResult": {
        "properties": {
          "firewallIntegration": {
            "type": "boolean"
          }
        },
        "type": "object",
        "required": [
          "firewallIntegration"
        ]
      }
    }
  }
}
