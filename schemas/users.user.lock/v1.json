{
  "name": "users.user.lock",
  "version": 1,
  "class": "compensable",
  "side": "agent",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/GuardedNameInput",
    "$defs": {
      "GuardContext": {
        "properties": {
          "client": {
            "$ref": "#/$defs/Peer"
          },
          "via": {
            "$ref": "#/$defs/ProxyPath"
          },
          "panelListen": {
            "items": {
              "type": "string",
              "format": "ip-address-port"
            },
            "type": "array"
          },
          "agentListen": {
            "items": {
              "type": "string",
              "format": "ip-address-port"
            },
            "type": "array"
          },
          "agentPeers": {
            "items": {
              "type": "string",
              "format": "ip-address"
            },
            "type": "array"
          },
          "complete": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "GuardedNameInput": {
        "properties": {
          "guard": {
            "$ref": "#/$defs/GuardContext"
          },
          "overrides": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
            "description": "The account name."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ]
      },
      "Peer": {
        "properties": {
          "addr": {
            "type": "string",
            "format": "ip-address"
          },
          "port": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "addr",
          "port"
        ]
      },
      "ProxyPath": {
        "properties": {
          "exposureId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "proxyAddr": {
            "type": "string",
            "format": "ip-address"
          },
          "listenerAddr": {
            "type": "string",
            "format": "ip-address-port"
          },
          "public": {
            "items": {
              "type": "string",
              "format": "ip-address-port"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "exposureId",
          "kind",
          "proxyAddr",
          "listenerAddr",
          "public"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/Changed",
    "$defs": {
      "Changed": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "name"
        ]
      }
    }
  }
}
