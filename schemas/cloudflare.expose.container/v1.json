{
  "name": "cloudflare.expose.container",
  "version": 1,
  "class": "composite",
  "side": "controller",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/ExposeInput",
    "$defs": {
      "ExposeInput": {
        "properties": {
          "hostId": {
            "type": "string"
          },
          "tunnel": {
            "type": "string"
          },
          "container": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "maximum": 65535,
            "minimum": 1
          },
          "network": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "hostId",
          "tunnel",
          "container",
          "port",
          "network",
          "hostname"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/ExposeOutput",
    "$defs": {
      "ExposeOutput": {
        "properties": {
          "hostname": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "network": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "hostname",
          "service",
          "network"
        ]
      }
    }
  }
}
