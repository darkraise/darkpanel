{
  "name": "core.user.list-tailnet-devices",
  "version": 1,
  "class": "read",
  "side": "controller",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/UsernameInput",
    "$defs": {
      "UsernameInput": {
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "description": "The user's name."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/TailnetDeviceList",
    "$defs": {
      "TailnetDevice": {
        "properties": {
          "stableId": {
            "type": "string"
          },
          "nodeName": {
            "type": "string"
          },
          "rememberedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "type": "object",
        "required": [
          "stableId",
          "nodeName",
          "rememberedAt",
          "lastUsedAt"
        ]
      },
      "TailnetDeviceList": {
        "properties": {
          "devices": {
            "items": {
              "$ref": "#/$defs/TailnetDevice"
            },
            "type": "array",
            "description": "The user's remembered Tailscale devices, most recently used first. Continue as from one of them asks no code."
          }
        },
        "type": "object",
        "required": [
          "devices"
        ]
      }
    }
  }
}
