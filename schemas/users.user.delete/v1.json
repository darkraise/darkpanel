{
  "name": "users.user.delete",
  "version": 1,
  "class": "irreversible",
  "side": "agent",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/DeleteInput",
    "$defs": {
      "DeleteInput": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
            "description": "The account name."
          },
          "removeHome": {
            "type": "boolean",
            "description": "Delete the home directory and mail spool too."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/Changed",
    "$defs": {
      "Changed": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "name"
        ]
      }
    }
  }
}
