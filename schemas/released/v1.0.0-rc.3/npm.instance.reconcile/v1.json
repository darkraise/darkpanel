{
  "name": "npm.instance.reconcile",
  "version": 1,
  "class": "compensable",
  "side": "agent",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/ReconcileInput",
    "$defs": {
      "ReconcileInput": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/Reconciled",
    "$defs": {
      "DroppedNetwork": {
        "properties": {
          "network": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "claimants": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "network",
          "address",
          "claimants"
        ]
      },
      "Reconciled": {
        "properties": {
          "dropped": {
            "items": {
              "$ref": "#/$defs/DroppedNetwork"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "dropped"
        ]
      }
    }
  }
}
