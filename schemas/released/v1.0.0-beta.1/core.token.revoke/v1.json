{
  "name": "core.token.revoke",
  "version": 1,
  "class": "irreversible",
  "side": "controller",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/TokenRevokeInput",
    "$defs": {
      "TokenRevokeInput": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Id of one of the calling user's tokens."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/TokenInfo",
    "$defs": {
      "TokenInfo": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastUsedAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "revokedAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "scope",
          "createdAt",
          "expiresAt",
          "lastUsedAt",
          "revokedAt"
        ]
      }
    }
  }
}
