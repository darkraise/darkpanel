{
  "name": "firewall.status",
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/Status",
    "$defs": {
      "ChainDifference": {
        "properties": {
          "family": {
            "type": "string"
          },
          "table": {
            "type": "string"
          },
          "chain": {
            "type": "string"
          },
          "policyPredicted": {
            "type": "string"
          },
          "policyLoaded": {
            "type": "string"
          },
          "onlyPredicted": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "onlyLoaded": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "orderDiffers": {
            "type": "boolean"
          }
        },
        "type": "object",
        "required": [
          "family",
          "table",
          "chain"
        ]
      },
      "Configured": {
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "logLevel": {
            "type": "string"
          },
          "ipv6": {
            "type": "boolean"
          },
          "defaults": {
            "$ref": "#/$defs/Defaults"
          },
          "sysctlFile": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "enabled",
          "logLevel",
          "ipv6",
          "defaults"
        ]
      },
      "Defaults": {
        "properties": {
          "incoming": {
            "type": "string"
          },
          "outgoing": {
            "type": "string"
          },
          "routed": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "incoming",
          "outgoing",
          "routed"
        ]
      },
      "LoadedChain": {
        "properties": {
          "family": {
            "type": "string"
          },
          "table": {
            "type": "string"
          },
          "chain": {
            "type": "string"
          },
          "policy": {
            "type": "string"
          },
          "rules": {
            "type": "integer"
          }
        },
        "type": "object",
        "required": [
          "family",
          "table",
          "chain",
          "rules"
        ]
      },
      "LoadedState": {
        "properties": {
          "variant": {
            "type": "string"
          },
          "ipv6": {
            "type": "boolean"
          },
          "sysctl": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "chains": {
            "items": {
              "$ref": "#/$defs/LoadedChain"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "variant",
          "ipv6",
          "sysctl",
          "chains"
        ]
      },
      "Rule": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|manual-[0-9a-f]{16})$",
            "description": "Rule id: the ULID in a Darkpanel rule's tag, or manual- and 16 hex digits derived from a manual rule's tuple."
          },
          "action": {
            "type": "string",
            "enum": [
              "allow",
              "deny",
              "limit",
              "reject"
            ],
            "description": "What the rule does; limit only for incoming rules."
          },
          "direction": {
            "type": "string",
            "enum": [
              "in",
              "out",
              "route"
            ],
            "description": "Incoming, outgoing or routed (forwarded) traffic."
          },
          "proto": {
            "type": "string",
            "enum": [
              "tcp",
              "udp",
              "any",
              "ah",
              "esp",
              "gre",
              "ipv6",
              "igmp"
            ],
            "description": "Protocol; ah, esp, gre, ipv6 and igmp take no ports, ipv6 and igmp only with family v4."
          },
          "from": {
            "type": "string",
            "pattern": "^(any|[0-9A-Fa-f:./]{2,43})$",
            "description": "Source: any, an address or a CIDR in canonical form."
          },
          "fromPort": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,4}(:[1-9][0-9]{0,4})?(,[1-9][0-9]{0,4}(:[1-9][0-9]{0,4})?)*$",
            "description": "Source port, range a:b or ascending comma list of at most 15 multiport slots; ranges and lists need tcp or udp."
          },
          "to": {
            "type": "string",
            "pattern": "^(any|[0-9A-Fa-f:./]{2,43})$",
            "description": "Destination: any, an address or a CIDR in canonical form."
          },
          "toPort": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,4}(:[1-9][0-9]{0,4})?(,[1-9][0-9]{0,4}(:[1-9][0-9]{0,4})?)*$",
            "description": "Destination port, range a:b or ascending comma list of at most 15 multiport slots; ranges and lists need tcp or udp."
          },
          "inIface": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.+-]{0,14}$",
            "description": "Interface the packet arrives on; only for in and route rules."
          },
          "outIface": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.+-]{0,14}$",
            "description": "Interface the packet leaves on; only for out and route rules."
          },
          "family": {
            "type": "string",
            "enum": [
              "v4",
              "v6",
              "both"
            ],
            "description": "IP family; both only when from and to are any."
          },
          "log": {
            "type": "string",
            "enum": [
              "off",
              "log",
              "log-all"
            ],
            "description": "Logging; off when omitted."
          },
          "comment": {
            "type": "string",
            "pattern": "^[A-Za-z0-9 :._/-]{0,64}$",
            "description": "Label after the Darkpanel tag, or a manual rule's comment."
          },
          "origin": {
            "type": "string",
            "enum": [
              "darkpanel",
              "manual"
            ],
            "description": "Who made the rule; darkpanel when omitted."
          },
          "raw": {
            "type": "string",
            "description": "Read-only: the tuple of a manual rule the model cannot express; never accepted in input.",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "action",
          "direction",
          "proto",
          "from",
          "to",
          "family"
        ]
      },
      "Status": {
        "properties": {
          "supported": {
            "type": "boolean"
          },
          "unsupported": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "active": {
            "type": "boolean"
          },
          "inSync": {
            "type": "boolean"
          },
          "outOfSync": {
            "items": {
              "$ref": "#/$defs/ChainDifference"
            },
            "type": "array"
          },
          "syncError": {
            "type": "string"
          },
          "configured": {
            "$ref": "#/$defs/Configured"
          },
          "loaded": {
            "$ref": "#/$defs/LoadedState"
          },
          "rules": {
            "items": {
              "$ref": "#/$defs/Rule"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "supported",
          "unsupported",
          "active",
          "inSync",
          "outOfSync",
          "configured",
          "loaded",
          "rules"
        ]
      }
    }
  }
}
