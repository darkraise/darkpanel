{
  "name": "firewall.docker.set-sources",
  "version": 1,
  "class": "revertible",
  "side": "agent",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/DockerSourcesInput",
    "$defs": {
      "DockerSourcesInput": {
        "properties": {
          "guard": {
            "$ref": "#/$defs/GuardContext"
          },
          "overrides": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "privateSources": {
            "items": {
              "type": "string",
              "format": "ip-prefix"
            },
            "type": "array",
            "description": "The source ranges that reach every Docker network; omitted: kept."
          },
          "forwardExemptions": {
            "items": {
              "$ref": "#/$defs/Exemption"
            },
            "type": "array",
            "description": "The foreign port forwards into non-Docker destinations that the block lets through; omitted: kept."
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "Exemption": {
        "properties": {
          "inInterface": {
            "type": "string"
          },
          "origDestination": {
            "type": "string",
            "format": "ip-address"
          },
          "origPort": {
            "type": "integer"
          },
          "destination": {
            "type": "string",
            "format": "ip-address"
          },
          "proto": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "origDestination",
          "destination",
          "proto"
        ]
      },
      "GuardContext": {
        "properties": {
          "client": {
            "$ref": "#/$defs/Peer"
          },
          "via": {
            "$ref": "#/$defs/ProxyPath"
          },
          "panelListen": {
            "items": {
              "type": "string",
              "format": "ip-address-port"
            },
            "type": "array"
          },
          "agentListen": {
            "items": {
              "type": "string",
              "format": "ip-address-port"
            },
            "type": "array"
          },
          "agentPeers": {
            "items": {
              "type": "string",
              "format": "ip-address"
            },
            "type": "array"
          },
          "complete": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "Peer": {
        "properties": {
          "addr": {
            "type": "string",
            "format": "ip-address"
          },
          "port": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "addr",
          "port"
        ]
      },
      "ProxyPath": {
        "properties": {
          "exposureId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "proxyAddr": {
            "type": "string",
            "format": "ip-address"
          },
          "listenerAddr": {
            "type": "string",
            "format": "ip-address-port"
          },
          "public": {
            "items": {
              "type": "string",
              "format": "ip-address-port"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "exposureId",
          "kind",
          "proxyAddr",
          "listenerAddr",
          "public"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/ChangeOutput",
    "$defs": {
      "ChangeOutput": {
        "properties": {
          "snapshot": {
            "type": "string"
          },
          "rules": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "repairOutcome": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "snapshot"
        ]
      }
    }
  }
}
