{
  "name": "core.update.rollback",
  "version": 1,
  "class": "irreversible",
  "side": "agent",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/UpdateRollbackInput",
    "$defs": {
      "UpdateRollbackInput": {
        "properties": {
          "force": {
            "type": "boolean",
            "description": "Roll back although an enrolled agent runs a newer version than the previous binary."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "force"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/UpdateTransaction",
    "$defs": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable error code, such as update.signature_invalid."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation."
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ]
      },
      "UpdateTransaction": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Transaction id."
          },
          "operationId": {
            "type": "string",
            "description": "Id of the operation: the id of its first transaction."
          },
          "parentId": {
            "oneOf": [
              {
                "type": "string",
                "description": "The previous step of a stepped update; null for the first."
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "update",
              "rollback"
            ],
            "description": "update or rollback."
          },
          "fromVersion": {
            "type": "string",
            "description": "Version running before this step."
          },
          "toVersion": {
            "type": "string",
            "description": "Version this step installs."
          },
          "targetVersion": {
            "type": "string",
            "description": "Version the whole operation ends on."
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "downloading",
              "staged",
              "swapped",
              "rolling-back",
              "committed",
              "rolled-back",
              "failed"
            ],
            "description": "Transaction state."
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/$defs/ErrorDetail",
                "description": "Why the step failed or rolled back; null otherwise."
              },
              {
                "type": "null"
              }
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the step started."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the step last changed state."
          }
        },
        "type": "object",
        "required": [
          "id",
          "operationId",
          "parentId",
          "kind",
          "fromVersion",
          "toVersion",
          "targetVersion",
          "state",
          "error",
          "startedAt",
          "updatedAt"
        ]
      }
    }
  }
}
