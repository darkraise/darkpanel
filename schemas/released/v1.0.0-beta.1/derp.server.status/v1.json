{
  "name": "derp.server.status",
  "version": 1,
  "class": "read",
  "side": "agent",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/ServerStatusInput",
    "$defs": {
      "ServerStatusInput": {
        "properties": {
          "whois": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 256,
            "description": "IP literals to look up on this host's tailscaled."
          }
        },
        "additionalProperties": false,
        "type": "object"
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/ServerStatus",
    "$defs": {
      "ServerStatus": {
        "properties": {
          "installed": {
            "type": "boolean",
            "description": "Whether a DERP server is installed on the host."
          },
          "mode": {
            "type": "string",
            "description": "The server's certificate mode; empty when not installed."
          },
          "hostName": {
            "type": "string",
            "description": "The server's DNS name or public IP literal."
          },
          "verifyClients": {
            "type": "boolean",
            "description": "Whether derper admits only nodes of this tailnet."
          },
          "derperVersion": {
            "type": "string",
            "description": "The derper version installed."
          },
          "unitActive": {
            "type": "boolean",
            "description": "Whether derper's unit is active."
          },
          "certName": {
            "type": "string",
            "description": "The certificate pin in ip mode; empty for letsencrypt."
          },
          "certNotAfter": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "When the ip certificate expires; null for letsencrypt."
              },
              {
                "type": "null"
              }
            ]
          },
          "availableVersion": {
            "type": "string",
            "description": "The derper version this agent's release carries."
          },
          "linkViaTailnet": {
            "type": "boolean",
            "description": "Whether the agent reaches its controller over a Tailscale address."
          },
          "onTailnet": {
            "type": "boolean",
            "description": "Whether tailscaled answers with BackendState Running."
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "The node's tags, sorted; empty when none."
          },
          "addresses": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "The node's Tailscale addresses, IPv4 first."
          },
          "visible": {
            "items": {
              "$ref": "#/$defs/Visibility"
            },
            "type": "array",
            "description": "One entry per looked-up address, in input order."
          }
        },
        "type": "object",
        "required": [
          "installed",
          "mode",
          "hostName",
          "verifyClients",
          "derperVersion",
          "unitActive",
          "certName",
          "certNotAfter",
          "availableVersion",
          "linkViaTailnet",
          "onTailnet",
          "tags",
          "addresses",
          "visible"
        ]
      },
      "Visibility": {
        "properties": {
          "address": {
            "type": "string",
            "description": "The address looked up."
          },
          "visible": {
            "type": "boolean",
            "description": "Whether a node holds the address."
          },
          "node": {
            "type": "string",
            "description": "The node's MagicDNS name without the trailing dot; empty when not visible."
          }
        },
        "type": "object",
        "required": [
          "address",
          "visible",
          "node"
        ]
      }
    }
  }
}
