{
  "name": "core.host.list",
  "version": 1,
  "class": "read",
  "side": "controller",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/NoInput",
    "$defs": {
      "NoInput": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/HostList",
    "$defs": {
      "Host": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Host id."
          },
          "name": {
            "type": "string",
            "description": "Host name."
          },
          "isLocal": {
            "type": "boolean",
            "description": "Whether the host runs this controller."
          },
          "online": {
            "type": "boolean",
            "description": "Whether the host's agent is reachable; always true for the local host in M1."
          },
          "modules": {
            "items": {
              "$ref": "#/$defs/ModuleState"
            },
            "type": "array",
            "description": "Every compiled-in module's state on the host."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "isLocal",
          "online",
          "modules"
        ]
      },
      "HostList": {
        "properties": {
          "hosts": {
            "items": {
              "$ref": "#/$defs/Host"
            },
            "type": "array",
            "description": "Every host, the local host first, then by name."
          }
        },
        "type": "object",
        "required": [
          "hosts"
        ]
      },
      "ModuleState": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Module id."
          },
          "version": {
            "type": "integer",
            "description": "Module version compiled into this binary."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether an operator enabled the module on the host."
          },
          "available": {
            "type": "boolean",
            "description": "Whether the module's migrations and preflight checks passed on the host."
          },
          "reason": {
            "oneOf": [
              {
                "type": "string",
                "description": "Why the module is unavailable; null when it is available."
              },
              {
                "type": "null"
              }
            ]
          },
          "checkedAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "When availability was last checked; null when it never was."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "version",
          "enabled",
          "available",
          "reason",
          "checkedAt"
        ]
      }
    }
  }
}
