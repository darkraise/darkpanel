{
  "name": "firewall.logging.set",
  "version": 1,
  "class": "revertible",
  "side": "agent",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/LoggingInput",
    "$defs": {
      "GuardContext": {
        "properties": {
          "client": {
            "$ref": "#/$defs/Peer"
          },
          "via": {
            "$ref": "#/$defs/ProxyPath"
          },
          "panelListen": {
            "items": {
              "type": "string",
              "format": "ip-address-port"
            },
            "type": "array"
          },
          "agentListen": {
            "items": {
              "type": "string",
              "format": "ip-address-port"
            },
            "type": "array"
          },
          "agentPeers": {
            "items": {
              "type": "string",
              "format": "ip-address"
            },
            "type": "array"
          },
          "complete": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "LoggingInput": {
        "properties": {
          "guard": {
            "$ref": "#/$defs/GuardContext"
          },
          "overrides": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "level": {
            "type": "string",
            "enum": [
              "off",
              "low",
              "medium",
              "high",
              "full"
            ],
            "description": "UFW's logging level."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "level"
        ]
      },
      "Peer": {
        "properties": {
          "addr": {
            "type": "string",
            "format": "ip-address"
          },
          "port": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "addr",
          "port"
        ]
      },
      "ProxyPath": {
        "properties": {
          "exposureId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "proxyAddr": {
            "type": "string",
            "format": "ip-address"
          },
          "listenerAddr": {
            "type": "string",
            "format": "ip-address-port"
          },
          "public": {
            "items": {
              "type": "string",
              "format": "ip-address-port"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "exposureId",
          "kind",
          "proxyAddr",
          "listenerAddr",
          "public"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/ChangeOutput",
    "$defs": {
      "ChangeOutput": {
        "properties": {
          "snapshot": {
            "type": "string"
          },
          "rules": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "repairOutcome": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "snapshot"
        ]
      }
    }
  }
}
