{
  "name": "npm.instance.check",
  "version": 1,
  "class": "read",
  "side": "controller",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/CheckInput",
    "$defs": {
      "CheckInput": {
        "properties": {
          "hostId": {
            "type": "string",
            "minLength": 1
          },
          "integration": {
            "type": "boolean"
          },
          "firewall": {
            "type": "boolean",
            "description": "The host's firewall support (firewall.status supported) when the plan was made; compared only when present."
          },
          "ipv6": {
            "type": "boolean",
            "description": "The host's UFW IPv6 setting (firewall.status configured.ipv6) when the plan was made; compared only when present."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "hostId",
          "integration"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/CheckResult",
    "$defs": {
      "CheckResult": {
        "properties": {
          "integration": {
            "type": "boolean"
          }
        },
        "type": "object",
        "required": [
          "integration"
        ]
      }
    }
  }
}
