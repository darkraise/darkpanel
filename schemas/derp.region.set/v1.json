{
  "name": "derp.region.set",
  "version": 1,
  "class": "composite",
  "side": "controller",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/RegionSetInput",
    "$defs": {
      "RegionSetInput": {
        "properties": {
          "hostId": {
            "type": "string",
            "minLength": 1,
            "description": "Id of the host running the server."
          },
          "regionId": {
            "type": "integer",
            "maximum": 999,
            "minimum": 900,
            "description": "The region id, 900 to 999."
          },
          "regionCode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "description": "The region code."
          },
          "regionName": {
            "type": "string",
            "maxLength": 64,
            "description": "The region name."
          },
          "omitDefaultRegions": {
            "type": "boolean",
            "description": "Whether to drop Tailscale's default regions."
          },
          "acknowledge": {
            "type": "string",
            "description": "The typed acknowledgement of omitting the default regions."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "hostId",
          "regionId",
          "regionCode",
          "regionName"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/RegionChanged",
    "$defs": {
      "RegionChanged": {
        "properties": {
          "etag": {
            "type": "string",
            "description": "The policy's ETag after the change; empty when nothing changed."
          }
        },
        "type": "object",
        "required": [
          "etag"
        ]
      }
    }
  }
}
