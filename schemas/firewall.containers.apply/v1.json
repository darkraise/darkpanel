{
  "name": "firewall.containers.apply",
  "version": 1,
  "class": "revertible",
  "side": "agent",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/ContainersApplyInput",
    "$defs": {
      "Binding": {
        "properties": {
          "selector": {
            "type": "string"
          },
          "hostAddr": {
            "type": "string",
            "format": "ip-address"
          },
          "hostPort": {
            "type": "integer"
          },
          "proto": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "selector",
          "hostPort",
          "proto"
        ]
      },
      "ContainerOp": {
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "allow",
              "deny",
              "remove"
            ],
            "description": "What the operation does."
          },
          "binding": {
            "$ref": "#/$defs/Binding",
            "description": "The published container port of an allow or deny."
          },
          "from": {
            "type": "string",
            "format": "ip-prefix",
            "description": "The source range of an allow (omitted: every source) or a deny."
          },
          "id": {
            "type": "string",
            "description": "The container rule a remove deletes."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "op"
        ]
      },
      "ContainersApplyInput": {
        "properties": {
          "guard": {
            "$ref": "#/$defs/GuardContext"
          },
          "overrides": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ops": {
            "items": {
              "$ref": "#/$defs/ContainerOp"
            },
            "type": "array",
            "description": "The operations, applied in order; empty: re-realize the stored rows against the current containers."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ops"
        ]
      },
      "GuardContext": {
        "properties": {
          "client": {
            "$ref": "#/$defs/Peer"
          },
          "via": {
            "$ref": "#/$defs/ProxyPath"
          },
          "panelListen": {
            "items": {
              "type": "string",
              "format": "ip-address-port"
            },
            "type": "array"
          },
          "agentListen": {
            "items": {
              "type": "string",
              "format": "ip-address-port"
            },
            "type": "array"
          },
          "agentPeers": {
            "items": {
              "type": "string",
              "format": "ip-address"
            },
            "type": "array"
          },
          "complete": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "Peer": {
        "properties": {
          "addr": {
            "type": "string",
            "format": "ip-address"
          },
          "port": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "addr",
          "port"
        ]
      },
      "ProxyPath": {
        "properties": {
          "exposureId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "proxyAddr": {
            "type": "string",
            "format": "ip-address"
          },
          "listenerAddr": {
            "type": "string",
            "format": "ip-address-port"
          },
          "public": {
            "items": {
              "type": "string",
              "format": "ip-address-port"
            },
            "type": "array"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "exposureId",
          "kind",
          "proxyAddr",
          "listenerAddr",
          "public"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/ChangeOutput",
    "$defs": {
      "ChangeOutput": {
        "properties": {
          "snapshot": {
            "type": "string"
          },
          "rules": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "repairOutcome": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "snapshot"
        ]
      }
    }
  }
}
