{
  "name": "core.tailnetdevice.forget",
  "version": 1,
  "class": "irreversible",
  "side": "controller",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/TailnetDeviceInput",
    "$defs": {
      "TailnetDeviceInput": {
        "properties": {
          "stableId": {
            "type": "string",
            "minLength": 1,
            "description": "Tailscale stable node id of one of the calling user's remembered devices."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stableId"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/TailnetDevice",
    "$defs": {
      "TailnetDevice": {
        "properties": {
          "stableId": {
            "type": "string",
            "description": "Tailscale stable node id of the device."
          },
          "nodeName": {
            "type": "string",
            "description": "The node's MagicDNS name when it last signed in; empty when it has none."
          },
          "rememberedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When a right code first remembered the device."
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the device last signed its user in."
          }
        },
        "type": "object",
        "required": [
          "stableId",
          "nodeName",
          "rememberedAt",
          "lastUsedAt"
        ]
      }
    }
  }
}
