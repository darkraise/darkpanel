{
  "name": "users.password.set",
  "version": 1,
  "class": "compensable",
  "side": "agent",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/PasswordInput",
    "$defs": {
      "PasswordInput": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
            "description": "The account name."
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 8,
            "description": "8-256 characters with no control character.",
            "writeOnly": true,
            "x-secret": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "password"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/Changed",
    "$defs": {
      "Changed": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "name"
        ]
      }
    }
  }
}
