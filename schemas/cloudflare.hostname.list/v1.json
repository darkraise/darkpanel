{
  "name": "cloudflare.hostname.list",
  "version": 1,
  "class": "read",
  "side": "controller",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/HostnameListInput",
    "$defs": {
      "HostnameListInput": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/HostnameList",
    "$defs": {
      "HostnameList": {
        "properties": {
          "hostnames": {
            "items": {
              "$ref": "#/$defs/HostnameView"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "hostnames"
        ]
      },
      "HostnameView": {
        "properties": {
          "hostname": {
            "type": "string"
          },
          "tunnel": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "recordId": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "health": {
            "type": "string"
          },
          "checkedAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "hostname",
          "tunnel",
          "service",
          "phase",
          "health"
        ]
      }
    }
  }
}
