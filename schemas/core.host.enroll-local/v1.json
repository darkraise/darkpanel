{
  "name": "core.host.enroll-local",
  "version": 1,
  "class": "irreversible",
  "side": "controller",
  "breakGlass": true,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/NoInput",
    "$defs": {
      "NoInput": {
        "properties": {},
        "additionalProperties": false,
        "type": "object"
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/EnrollmentGrant",
    "$defs": {
      "EnrollmentGrant": {
        "properties": {
          "host": {
            "$ref": "#/$defs/Host",
            "description": "The host the token enrolls."
          },
          "token": {
            "type": "string",
            "description": "Single-use enrollment token for darkpanel agent enroll; shown only once.",
            "x-secret": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the token stops working, one hour after it was made."
          }
        },
        "type": "object",
        "required": [
          "host",
          "token",
          "expiresAt"
        ]
      },
      "Host": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Host id."
          },
          "name": {
            "type": "string",
            "description": "Host name."
          },
          "isLocal": {
            "type": "boolean",
            "description": "Whether the host runs this controller."
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "enrolled",
              "revoked"
            ],
            "description": "Enrollment state: pending until the agent enrolls, revoked after core.host.revoke."
          },
          "online": {
            "type": "boolean",
            "description": "Whether the host's agent has a live session with the controller."
          },
          "lastSeenAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "When the agent last answered; null when it never has."
              },
              {
                "type": "null"
              }
            ]
          },
          "agentVersion": {
            "oneOf": [
              {
                "type": "string",
                "description": "Version of the agent's binary; null until its first Hello."
              },
              {
                "type": "null"
              }
            ]
          },
          "protocolVersion": {
            "oneOf": [
              {
                "type": "integer",
                "description": "Agent protocol version; null until its first Hello."
              },
              {
                "type": "null"
              }
            ]
          },
          "os": {
            "oneOf": [
              {
                "type": "string",
                "description": "Operating system the agent reports; null until its first Hello."
              },
              {
                "type": "null"
              }
            ]
          },
          "arch": {
            "oneOf": [
              {
                "type": "string",
                "description": "CPU architecture the agent reports; null until its first Hello."
              },
              {
                "type": "null"
              }
            ]
          },
          "supported": {
            "type": "boolean",
            "description": "Whether the agent's version is inside the controller's support window; an unsupported agent accepts only update actions."
          },
          "modules": {
            "items": {
              "$ref": "#/$defs/ModuleState"
            },
            "type": "array",
            "description": "Every compiled-in module's state on the host."
          },
          "ingestion": {
            "oneOf": [
              {
                "$ref": "#/$defs/IngestionStatus",
                "description": "Journal ingestion health; null until the controller first ingests the host's journal."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "isLocal",
          "state",
          "online",
          "lastSeenAt",
          "agentVersion",
          "protocolVersion",
          "os",
          "arch",
          "supported",
          "modules",
          "ingestion"
        ]
      },
      "IngestionStatus": {
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "Whether the last ingestion succeeded."
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "description": "When the current state began."
          },
          "error": {
            "oneOf": [
              {
                "type": "string",
                "description": "The last ingestion error; null while ingestion succeeds."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "ok",
          "since",
          "error"
        ]
      },
      "ModuleState": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Module id."
          },
          "version": {
            "type": "integer",
            "description": "Module version compiled into this binary."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether an operator enabled the module on the host."
          },
          "available": {
            "type": "boolean",
            "description": "Whether the module's migrations and preflight checks passed on the host."
          },
          "reason": {
            "oneOf": [
              {
                "type": "string",
                "description": "Why the module is unavailable; null when it is available."
              },
              {
                "type": "null"
              }
            ]
          },
          "checkedAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "When availability was last checked; null when it never was."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "version",
          "enabled",
          "available",
          "reason",
          "checkedAt"
        ]
      }
    }
  }
}
