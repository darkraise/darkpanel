          "claimant"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/Attachment",
    "$defs": {
      "Attachment": {
        "properties": {
          "network": {
            "type": "string"
          },
          "claimant": {
            "type": "string"
          },
          "preexisting": {
            "type": "boolean"
          },
          "attached": {
            "type": "boolean"
          }
        },
        "type": "object",
        "required": [
