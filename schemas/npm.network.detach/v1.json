{
  "name": "npm.network.detach",
  "version": 1,
  "class": "compensable",
  "side": "agent",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/DetachInput",
    "$defs": {
