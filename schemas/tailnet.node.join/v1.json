{
  "name": "tailnet.node.join",
  "version": 1,
  "class": "composite",
  "side": "controller",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/NodeJoinInput",
    "$defs": {
      "NodeJoinInput": {
        "properties": {
          "hostId": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "install": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "hostId"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/NodeJoined",
    "$defs": {
      "NodeJoined": {
        "properties": {
          "backendState": {
            "type": "string"
          },
          "addresses": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "backendState",
          "addresses"
        ]
      }
    }
  }
}
