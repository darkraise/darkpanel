      "AutoUpdates": {
        "properties": {
          "installed": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "type": "object",
        "required": [
          "installed",
          "enabled"
        ]
      }
    }
  }
}
