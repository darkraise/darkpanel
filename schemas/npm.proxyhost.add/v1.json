{
  "name": "npm.proxyhost.add",
  "version": 1,
  "class": "compensable",
  "side": "agent",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/ProxyHostInput",
    "$defs": {
      "ProxyHostInput": {
        "properties": {
          "domains": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "forwardScheme": {
            "type": "string",
            "enum": [
              "http",
              "https"
            ]
          },
          "forwardHost": {
            "type": "string"
          },
          "forwardPort": {
            "type": "integer",
            "maximum": 65535,
            "minimum": 1
          },
          "certificateId": {
            "type": "integer"
          },
          "accessListId": {
            "type": "integer"
          },
          "sslForced": {
            "type": "boolean"
          },
          "hsts": {
            "type": "boolean"
          },
          "websockets": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "domains",
          "forwardScheme",
          "forwardHost",
          "forwardPort"
        ]
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/ProxyHostView",
    "$defs": {
      "ProxyHostView": {
        "properties": {
          "id": {
            "type": "integer"
          },
          "domains": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "forwardScheme": {
            "type": "string"
          },
          "forwardHost": {
            "type": "string"
          },
          "forwardPort": {
            "type": "integer"
          },
          "certificateId": {
            "type": "integer"
          },
          "accessListId": {
            "type": "integer"
          },
          "sslForced": {
            "type": "boolean"
          },
          "hsts": {
            "type": "boolean"
          },
          "websockets": {
            "type": "boolean"
          },
          "reserved": {
            "type": "string"
          },
          "unclaimed": {
            "type": "boolean"
          }
        },
        "type": "object",
        "required": [
          "id",
          "domains",
          "forwardScheme",
          "forwardHost",
          "forwardPort",
          "certificateId",
          "accessListId",
          "sslForced",
          "hsts",
          "websockets",
          "reserved",
          "unclaimed"
        ]
      }
    }
  }
}
