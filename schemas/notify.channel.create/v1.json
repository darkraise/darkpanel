{
  "name": "notify.channel.create",
  "version": 1,
  "class": "compensable",
  "side": "controller",
  "breakGlass": false,
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/ChannelInput",
    "$defs": {
      "ChannelInput": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "ntfy",
              "telegram",
              "discord",
              "email",
              "webhook"
            ],
            "description": "The channel kind."
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,47}$",
            "description": "The name: 1 to 48 letters, digits, spaces, dots, underscores or hyphens, starting with a letter or digit."
          },
          "minSeverity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ],
            "description": "The lowest severity the channel receives."
          },
          "kinds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "The event kinds the channel receives; empty receives every kind."
          },
          "groupIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "The host groups whose hosts' events the channel receives; empty receives every host's and host-less events."
          },
          "ntfy": {
            "$ref": "#/$defs/NtfyInput",
            "description": "The settings of an ntfy channel."
          },
          "telegram": {
            "$ref": "#/$defs/TelegramInput",
            "description": "The settings of a Telegram channel."
          },
          "discord": {
            "$ref": "#/$defs/DiscordInput",
            "description": "The settings of a Discord channel."
          },
          "email": {
            "$ref": "#/$defs/EmailInput",
            "description": "The settings of an email channel."
          },
          "webhook": {
            "$ref": "#/$defs/WebhookInput",
            "description": "The settings of a webhook channel."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "name",
          "minSeverity"
        ]
      },
      "DiscordInput": {
        "properties": {
          "webhookUrl": {
            "type": "string",
            "description": "The channel's https://discord.com/api/webhooks/... URL; write-only, required on create.",
            "writeOnly": true,
            "x-secret": true
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "EmailInput": {
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "description": "The SMTP server's host name or address."
          },
          "port": {
            "type": "integer",
            "maximum": 65535,
            "minimum": 1,
            "description": "The SMTP server's port."
          },
          "security": {
            "type": "string",
            "enum": [
              "starttls",
              "tls",
              "none"
            ],
            "description": "starttls, tls (implicit TLS) or none; none only to a loopback host."
          },
          "username": {
            "type": "string",
            "description": "The SMTP user name; omitted when the server needs no sign-in."
          },
          "password": {
            "type": "string",
            "description": "The SMTP password, with a user name; write-only, and an update keeps a stored one it omits.",
            "writeOnly": true,
            "x-secret": true
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "The sender address."
          },
          "recipients": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "description": "1 to 10 recipient addresses."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "host",
          "port",
          "security",
          "from",
          "recipients"
        ]
      },
      "NtfyInput": {
        "properties": {
          "server": {
            "type": "string",
            "description": "The ntfy server, an http or https URL; https://ntfy.sh when omitted."
          },
          "topic": {
            "type": "string",
            "description": "The topic, 1 to 64 letters, digits, hyphens or underscores; write-only, required on create.",
            "writeOnly": true,
            "x-secret": true
          },
          "token": {
            "type": "string",
            "description": "An access token sent as a bearer token; optional and write-only.",
            "writeOnly": true,
            "x-secret": true
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "TelegramInput": {
        "properties": {
          "botToken": {
            "type": "string",
            "description": "The bot's token from BotFather; write-only, required on create.",
            "writeOnly": true,
            "x-secret": true
          },
          "chatId": {
            "type": "string",
            "description": "The chat id, a number, or @ and a public channel's name."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "chatId"
        ]
      },
      "WebhookInput": {
        "properties": {
          "url": {
            "type": "string",
            "description": "The http or https URL the JSON body is posted to; write-only, required on create.",
            "writeOnly": true,
            "x-secret": true
          },
          "secret": {
            "type": "string",
            "description": "An HMAC-SHA256 key; the body's signature is sent as X-Darkpanel-Signature: sha256=\u003chex\u003e. Optional and write-only.",
            "writeOnly": true,
            "x-secret": true
          }
        },
        "additionalProperties": false,
        "type": "object"
      }
    }
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/Channel",
    "$defs": {
      "Channel": {
        "properties": {
          "id": {
            "type": "string",
            "description": "The channel's id."
          },
          "kind": {
            "type": "string",
            "description": "ntfy, telegram, discord, email or webhook."
          },
          "name": {
            "type": "string",
            "description": "The channel's name."
          },
          "minSeverity": {
            "type": "string",
            "description": "The lowest severity the channel receives."
          },
          "kinds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "The event kinds the channel receives; empty receives every kind."
          },
          "groupIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "The host groups the channel is limited to; empty is every host."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the channel receives events."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "ntfy": {
            "oneOf": [
              {
                "$ref": "#/$defs/NtfyView",
                "description": "An ntfy channel's settings; absent for another kind."
              },
              {
                "type": "null"
              }
            ]
          },
          "telegram": {
            "oneOf": [
              {
                "$ref": "#/$defs/TelegramView",
                "description": "A Telegram channel's settings; absent for another kind."
              },
              {
                "type": "null"
              }
            ]
          },
          "discord": {
            "oneOf": [
              {
                "$ref": "#/$defs/DiscordView",
                "description": "A Discord channel's settings; absent for another kind."
              },
              {
                "type": "null"
              }
            ]
          },
          "email": {
            "oneOf": [
              {
                "$ref": "#/$defs/EmailView",
                "description": "An email channel's settings; absent for another kind."
              },
              {
                "type": "null"
              }
            ]
          },
          "webhook": {
            "oneOf": [
              {
                "$ref": "#/$defs/WebhookView",
                "description": "A webhook channel's settings; absent for another kind."
              },
              {
                "type": "null"
              }
            ]
          },
          "lastDelivery": {
            "oneOf": [
              {
                "$ref": "#/$defs/Delivery",
                "description": "The latest finished delivery; null before the first."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "minSeverity",
          "kinds",
          "groupIds",
          "enabled",
          "createdAt",
          "lastDelivery"
        ]
      },
      "Delivery": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "sent",
              "failed"
            ],
            "description": "sent or failed."
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "description": "When the delivery finished."
          },
          "error": {
            "type": "string",
            "description": "A failed delivery's reason: an HTTP status, an SMTP reply code or a short code; never a provider's body."
          }
        },
        "type": "object",
        "required": [
          "state",
          "at"
        ]
      },
      "DiscordView": {
        "properties": {},
        "type": "object"
      },
      "EmailView": {
        "properties": {
          "host": {
            "type": "string",
            "description": "The SMTP server's host."
          },
          "port": {
            "type": "integer",
            "description": "The SMTP server's port."
          },
          "security": {
            "type": "string",
            "description": "starttls, tls or none."
          },
          "username": {
            "type": "string",
            "description": "The SMTP user name; empty for none."
          },
          "passwordSet": {
            "type": "boolean",
            "description": "Whether a password is stored."
          },
          "from": {
            "type": "string",
            "description": "The sender address."
          },
          "recipients": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "The recipient addresses."
          }
        },
        "type": "object",
        "required": [
          "host",
          "port",
          "security",
          "username",
          "passwordSet",
          "from",
          "recipients"
        ]
      },
      "NtfyView": {
        "properties": {
          "server": {
            "type": "string",
            "description": "The ntfy server."
          },
          "topic": {
            "type": "string",
            "description": "The topic's first 4 characters and an ellipsis."
          },
          "tokenSet": {
            "type": "boolean",
            "description": "Whether an access token is stored."
          }
        },
        "type": "object",
        "required": [
          "server",
          "topic",
          "tokenSet"
        ]
      },
      "TelegramView": {
        "properties": {
          "chatId": {
            "type": "string",
            "description": "The chat id."
          }
        },
        "type": "object",
        "required": [
          "chatId"
        ]
      },
      "WebhookView": {
        "properties": {
          "url": {
            "type": "string",
            "description": "The URL's first 4 characters and an ellipsis."
          },
          "secretSet": {
            "type": "boolean",
            "description": "Whether an HMAC key is stored."
          }
        },
        "type": "object",
        "required": [
          "url",
          "secretSet"
        ]
      }
    }
  }
}
